              "request_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "provider_id": {
                "const": "public.play.integrity"
              }
            }
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300000
          }
