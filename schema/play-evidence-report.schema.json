          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "OBSERVED",
              "BLOCKED",
              "MISSING",
              "NOT_RUN"
            ]
          },
          "reason": {
            "enum": [
              "SERVICE_AVAILABLE",
              "USER_MATCHED",
              "PROFILE_HASH_MATCHED",
              "SERVICE_UNAVAILABLE",
              "USER_MISMATCH",
              "PROFILE_HASH_MISMATCH",
              "COLLECTION_FAILED",
              "PACKAGE_OBSERVED",
              "PROVIDER_OBSERVED",
              "RESOLVABLE_NOT_ACCESS_PROOF",
              "VISIBLE_ACCOUNT",
              "NO_CALLER_VISIBLE_ACCOUNT",
              "TOKEN_RECEIVED",
              "PERMISSION_DENIED",
              "API_ERROR",
              "PACKAGE_DISABLED",
              "INTEGRITY_API_ERROR",
              "NOT_VISIBLE_OR_MISSING",
              "NO_PROVIDER",
              "SETTINGS_NOT_RESOLVABLE",
              "PROFILE_INPUT_MISSING",
              "NO_PUBLIC_OBSERVATION",
              "USER_NOT_REQUESTED",
              "BACKEND_VERIFICATION_REQUIRED"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "package_name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
              },
              "version_name": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]*$"
              },
              "version_code": {
