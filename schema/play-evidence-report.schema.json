        "properties": {
          "id": {
            "enum": [
              "package.com.google.android.gms",
              "package.com.android.vending",
              "package.com.google.android.gsf",
              "package.com.google.android.webview",
              "package.com.android.webview",
              "package.com.android.chrome",
