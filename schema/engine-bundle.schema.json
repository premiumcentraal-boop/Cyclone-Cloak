{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/premiumcentraal-boop/Cyclone-Cloak/schema/engine-bundle.schema.json",
  "title": "Cyclone Cloak engine bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "metadata"
  ],
  "properties": {
    "profile": {
      "$ref": "cloak-profile.schema.json"
    },
    "posture": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "uniqueness": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "schema_version",
        "template"
      ],
      "properties": {
        "engine_version": {
          "const": "1"
        },
        "schema_version": {
          "enum": [
            "0.2",
            "0.3",
            "0.4"
          ]
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "source_confidence": {
          "enum": [
            "public reference",
            "approximated",
            "needs verification"
          ]
        },
        "chosen_seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "instance_realism": {
          "$ref": "instance-realism.schema.json"
        },
        "realism_request_seed": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "dependentRequired": {
        "chosen_seed": [
          "attempt_count"
        ],
        "attempt_count": [
          "chosen_seed"
        ],
        "instance_realism": [
          "realism_request_seed"
        ],
        "realism_request_seed": [
          "instance_realism"
        ]
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message",
        "field"
      ],
      "properties": {
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
