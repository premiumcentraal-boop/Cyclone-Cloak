  "$id": "https://cyclone.local/schema/play-evidence-report.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profile_id",
    "profile_hash",
    "artifact_hash",
    "android_user_id",
    "timestamp",
    "request_id",
    "rows",
    "warnings",
    "readiness_report"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "android_user_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 21474
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "rows": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "reason",
          "metadata",
          "duration_ms"
